# Frontend Environment Variables
VITE_API_URL=http://localhost:3001

# Backend Environment Variables
DATABASE_URL=postgresql://user:password@localhost:5432/brazilfit
NODE_ENV=development
PORT=3001
JWT_SECRET=your_jwt_secret_key_here_min_32_chars
JWT_EXPIRE=24h
REFRESH_TOKEN_EXPIRE=30d

# Stripe (for Pro subscriptions)
STRIPE_PUBLIC_KEY=pk_test_your_stripe_key
STRIPE_SECRET_KEY=sk_test_your_stripe_key

# Email (for notifications)
SENDGRID_API_KEY=your_sendgrid_api_key
SENDGRID_FROM_EMAIL=noreply@brazilfit.com

# Security
BCRYPT_ROUNDS=12
SESSION_SECRET=your_session_secret_min_32_chars
CORS_ORIGIN=http://localhost:5173

# Apple Health (optional)
APPLE_HEALTH_CLIENT_ID=your_apple_client_id
APPLE_HEALTH_CLIENT_SECRET=your_apple_secret

# File Upload
MAX_FILE_SIZE=5242880
ALLOWED_FILE_TYPES=jpg,jpeg,png,gif,webp
UPLOAD_DIR=./uploads

# Rate Limiting
RATE_LIMIT_WINDOW=60000
RATE_LIMIT_MAX_REQUESTS=100
LOGIN_RATE_LIMIT_WINDOW=900000
LOGIN_RATE_LIMIT_MAX_ATTEMPTS=5

# Logging
LOG_LEVEL=info
